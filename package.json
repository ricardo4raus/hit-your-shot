{
  "name": "hit-your-shot",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx tools/simulate.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/src/**/__tests__/**/*.test.ts",
      "**/tools/**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/lilita-one": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@shopify/react-native-skia": "2.14.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.25",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-dom": "19.3.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
